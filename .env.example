# Copiez ce fichier en .env.local puis renseignez vos propres valeurs.
# Où les trouver : tableau de bord Supabase > Project Settings > API
#   - Project URL          -> VITE_SUPABASE_URL
#   - anon public API key  -> VITE_SUPABASE_ANON_KEY
#
# IMPORTANT : ne mettez JAMAIS la clé "service_role" dans ce fichier.
# Elle contourne la Row Level Security et ne doit jamais être exposée au navigateur.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
